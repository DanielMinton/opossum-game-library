{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Game asset inventory",
  "type": "object",
  "required": [
    "version",
    "assets"
  ],
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": 1
    },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "category",
          "files",
          "readiness",
          "description",
          "missing"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "category": {
            "enum": [
              "character",
              "enemy",
              "npc",
              "item",
              "prop",
              "environment",
              "ui",
              "audio",
              "reference"
            ]
          },
          "files": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "readiness": {
            "enum": [
              "reference",
              "needs-preparation",
              "ready"
            ]
          },
          "description": {
            "type": "string"
          },
          "metadata": {
            "type": [
              "string",
              "null"
            ]
          },
          "interaction": {
            "type": [
              "string",
              "null"
            ]
          },
          "missing": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "notes": {
            "type": "string"
          }
        }
      }
    }
  }
}
