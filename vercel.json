{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "if [ -d game ]; then cd game && node tools/build.mjs; else node tools/build.mjs && rm -rf game && mkdir -p game && cp -R dist game/dist; fi",
  "outputDirectory": "game/dist",
  "installCommand": "echo no dependencies",
  "framework": null,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    }
  ]
}
